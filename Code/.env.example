# ============================================================
# Automotive TARA AI Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Configuration ---
# Provider: "gemini" | "openai" | "local" | "demo"
# "gemini" = Google Gemini API (official google-genai SDK, fast recommended default)
# "openai" = OpenAI-compatible API (OpenAI, Azure, etc.)
# "local"  = Local model endpoint (Ollama OpenAI-compatible, e.g. llama3.1:8b)
# "demo"   = DEMO/FALLBACK mode (no real LLM, pre-written responses)
LLM_PROVIDER=gemini

# Google Gemini API configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible API settings
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local model endpoint (e.g., Ollama, LM Studio, vLLM)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# --- Embedding Model ---
# sentence-transformers model name (downloaded automatically)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- SQLite Database ---
SQLITE_DB_PATH=./data/sqlite/tara.db

# --- Report Export ---
EXPORT_DIR=./data/exports

# --- Application ---
PROJECT_NAME=Automotive TARA AI Assistant
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STREAMLIT_PORT=8501

# --- Optional Authentication (disabled by default) ---
# Set to "true" to enable basic auth
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=tara_demo_2024

# --- Chunking Configuration ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Ingestion Configuration ---
MAX_FILE_SIZE_MB=50

# --- Retrieval Configuration ---
RETRIEVAL_TOP_K=5
